{
  "name": "Ernst Dark",
  "type": "dark",
  "colors": {
    "foreground": "#BBBBBB",
    "descriptionForeground": "#888888",
    "errorForeground": "#cf222e",
    "editorWarning.foreground": "#ff6044",
    "editorInfo.foreground": "#609cdf",
    "gitDecoration.addedResourceForeground": "#3aab5f",
    "panel.border": "#555555",
    "editorGroup.border": "#000000",

    "button.background": "#555555",
    "button.foreground": "#EEEEEE",
    "button.hoverBackground": "#666666",
    "button.secondaryBackground": "#4a4a4a",
    "button.secondaryHoverBackground": "#5a5a5a",
    "button.border": "#606060",

    "input.background": "#202020",
    "input.border": "#202020",
    "input.foreground": "#BBBBBB",
    "input.placeholderForeground": "#555555",

    "list.hoverBackground": "#202020",
    "list.activeSelectionBackground": "#262626",
    "list.activeSelectionForeground": "#EEEEEE",

    "menu.background": "#2d2d2d",
    "menu.foreground": "#EEEEEE",
    "menu.border": "#404040",
    "menu.selectionBackground": "#404040",

    "sideBar.background": "#181818",
    "sideBar.foreground": "#BBBBBB",
    "sideBar.border": "#202020",

    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#BBBBBB",

    "editorGroupHeader.tabsBackground": "#181818",
    "tab.inactiveForeground": "#666666",
    "tab.activeBackground": "#262626",
    "tab.activeForeground": "#BBBBBB",

    "editor.background": "#181818",
    "editor.foreground": "#BBBBBB",
    "editor.selectionBackground": "#BBBBBB44",
    "editor.selectionHighlightBackground": "#BBBBBB44",
    "editor.lineHighlightBackground": "#202020",
    "editor.findMatchBackground": "#BBBBBB66",
    "editor.findMatchHighlightBackground": "#BBBBBB44",
    "editorCursor.foreground": "#BBBBBB",
    "editorLineNumber.foreground": "#666666",
    "editorLineNumber.activeForeground": "#BBBBBB",
    "editorWhitespace.foreground": "#555555",
    "editorGutter.background": "#181818",
    "scrollbarSlider.background": "#202020",
    "scrollbarSlider.hoverBackground": "#202020",
    "scrollbarSlider.activeBackground": "#202020"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#666666" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#3aab5f" } },
    { "scope": ["support.function", "entity.name.function"], "settings": { "foreground": "#609cdf" } },
    { "scope": "string", "settings": { "foreground": "#032f62" } },
    { "scope": ["constant", "constant.numeric", "constant.character.escape"], "settings": { "foreground": "#c739ff" } },
    { "scope": "variable", "settings": { "foreground": "#BBBBBB" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#ff6044" } },
    { "scope": "punctuation", "settings": { "foreground": "#555555" } },
    { "scope": "meta.preprocessor", "settings": { "foreground": "#888888" } }
  ]
}
