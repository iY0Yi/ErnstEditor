{
  "name": "Ernst Monotone",
  "type": "dark",
  "colors": {
    "foreground": "#cccccc",
    "descriptionForeground": "#999999",
    "errorForeground": "#cccccc",
    "editorWarning.foreground": "#aaaaaa",
    "editorInfo.foreground": "#999999",
    "gitDecoration.addedResourceForeground": "#888888",
    "panel.border": "#444444",
    "editorGroup.border": "#1a1a1a",

    "button.background": "#888888",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#aaaaaa",

    "input.background": "#2a2a2a",
    "input.border": "#444444",
    "input.foreground": "#cccccc",
    "input.placeholderForeground": "#999999",

    "list.hoverBackground": "#2C2C2C",
    "list.activeSelectionBackground": "#353535",
    "list.activeSelectionForeground": "#efebdc",

    "sideBar.background": "#262525",
    "sideBar.foreground": "#d8d4c5",
    "sideBar.border": "#6f6b5c",

    "titleBar.activeBackground": "#262525",
    "titleBar.activeForeground": "#d8d4c5",
    "titleBar.border": "#6f6b5c",

    "editorGroupHeader.tabsBackground": "#262525",
    "tab.inactiveForeground": "#6f6b5c",
    "tab.activeBackground": "#353535",
    "tab.activeForeground": "#d8d4c5",

    "editor.background": "#222222",
    "editor.foreground": "#cccccc",
    "editor.lineHighlightBackground": "#2a2a2a",
    "editor.selectionBackground": "#444444",
    "editor.findMatchBackground": "#555555",
    "editor.wordHighlightBackground": "#44444480",
    "editor.wordHighlightStrongBackground": "#55555580",
    "editorCursor.foreground": "#ffffff",
    "editorLineNumber.foreground": "#666666",
    "editorLineNumber.activeForeground": "#cccccc",
    "editorRuler.foreground": "#333333",
    "editorBracketMatch.border": "#888888",
    "editorIndentGuide.background": "#333333",
    "editorWhitespace.foreground": "#444444"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#666666" } },
    { "scope": ["keyword", "keyword.operator", "constant", "punctuation"], "settings": { "foreground": "#cccccc" } },
    { "scope": "string", "settings": { "foreground": "#999999" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#aaaaaa" } },
    { "scope": ["entity.name.function", "support.function", "storage.type", "support.type", "entity.name.type", "entity.name.tag"], "settings": { "foreground": "#bbbbbb" } },
    { "scope": ["variable", "entity.other.attribute-name"], "settings": { "foreground": "#aaaaaa" } },
    { "scope": "support.type.property-name", "settings": { "foreground": "#999999" } }
  ]
}
